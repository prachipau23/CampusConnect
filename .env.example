# CampusConnect Backend — Required Environment Variables
# Copy this file to .env for local development (never commit .env)
# Set these variables in Render's environment settings for production.

# ─── Database (Render Postgres, created via API) ───────────────────────────────
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend's Vercel or GitHub Pages URL (no trailing slash)
# Example: https://campusconnect-frontend.vercel.app
FRONTEND_ORIGIN=

# ─── Render Port (set automatically by Render, do not override) ────────────────
# PORT=8080

# ─── Seed Data (set to true on first deploy only, then flip to false) ──────────
# SEED_ENABLED=true
